# Ambiente: dev | prod
APP_ENV=dev
APP_DEBUG=true

# SQLite (dev)
DB_DSN=sqlite:./database.sqlite
# Postgres (prod):  DB_DSN=pgsql:host=localhost;port=5432;dbname=thzmkt
# MySQL (prod):     DB_DSN=mysql:host=localhost;port=3306;dbname=thzmkt;charset=utf8mb4

DB_USER=
DB_PASS=

# Origem permitida para CORS (padrão: qualquer)
CORS_ORIGIN=*

# Log (usado em prod; em dev os logs vão para stderr)
# LOG_PATH=./var/logs/app.log